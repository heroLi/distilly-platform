@@ -0,0 +1,75 @@
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))
+import artifact_store
+from skill_writer import create_skill, update_skill
+from version_manager import rollback
+
+
+class ArtifactIntegrityTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.skill = create_skill(self.root, "demo", {"name": "Demo"},
+                                  "## Rules\n- A\n- B\n", "## Correction Log\n")
+
+    def test_duplicate_creation_does_not_overwrite(self):
+        before = (self.skill / "meta.json").read_bytes()
+        with self.assertRaises(FileExistsError):
+            create_skill(self.root, "demo", {"name": "Other"}, "bad", "bad")
+        self.assertEqual(before, (self.skill / "meta.json").read_bytes())
+        self.assertIn("- A", (self.skill / "work.md").read_text())
+
+    def test_append_preserves_old_section_and_deduplicates_repeat(self):
+        update_skill(self.skill, work_patch="## Rules\n- C\n")
+        update_skill(self.skill, work_patch="## Rules\n- C\n")
+        text = (self.skill / "work.md").read_text()
+        self.assertIn("- A", text)
+        self.assertIn("- B", text)
+        self.assertEqual(text.count("- C"), 1)
+        self.assertEqual(text.count("## Rules"), 1)
+
+    def test_rollback_restores_metadata_and_never_reuses_archive(self):
+        update_skill(self.skill, correction={"wrong": "x", "correct": "y"})
+        update_skill(self.skill, work_patch="## Rules\n- original v3\n")
+        old_v2 = (self.skill / "versions/v2/work.md").read_bytes()
+        self.assertTrue(rollback(self.skill, "v1"))
+        meta = json.loads((self.skill / "meta.json").read_text())
+        self.assertEqual(meta["corrections_count"], 0)
+        self.assertNotIn("should not x", (self.skill / "persona.md").read_text())
+        self.assertEqual(update_skill(self.skill, work_patch="## Rules\n- branch\n"), "v4")
+        update_skill(self.skill, work_patch="## Rules\n- next\n")
+        self.assertEqual(old_v2, (self.skill / "versions/v2/work.md").read_bytes())
+
+    def test_failed_commit_restores_all_previous_artifacts(self):
+        before = {p.name: p.read_bytes() for p in self.skill.iterdir() if p.is_file()}
+        original = artifact_store.os.replace
+        count = 0
+
+        def fail_once(source, target):
+            nonlocal count
+            count += 1
+            if count == 3:
+                raise OSError("injected write failure")
+            return original(source, target)
+
+        with patch.object(artifact_store.os, "replace", side_effect=fail_once):
+            with self.assertRaises(OSError):
+                update_skill(self.skill, work_patch="bad")
+        self.assertEqual(before, {p.name: p.read_bytes() for p in self.skill.iterdir() if p.is_file()})
+
+    def test_artifact_filename_cannot_escape_profile(self):
+        with self.assertRaises(ValueError):
+            create_skill(self.root, "unsafe", {"artifacts": {"work_doc": "../outside"}}, "x", "y")
+        self.assertFalse((self.root / "outside").exists())
+        self.assertFalse((self.root / "unsafe").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
