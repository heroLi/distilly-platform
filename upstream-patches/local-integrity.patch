new file mode 100644
index 0000000..086e1e0
--- /dev/null
+++ b/tools/artifact_store.py
@@ -0,0 +1,102 @@
+"""Serialized artifact transactions and immutable snapshots for local profiles."""
+from __future__ import annotations
+
+import os
+import re
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+from skill_schema import PRIMARY_ARTIFACTS, resolve_contained_child
+
+
+@contextmanager
+def profile_lock(skill_dir: Path):
+    """Lock across processes; lock lives next to the profile, never in its snapshot."""
+    skill_dir.parent.mkdir(parents=True, exist_ok=True)
+    lock = skill_dir.parent / f".{skill_dir.name}.distilly.lock"
+    if lock.is_symlink():
+        raise ValueError("profile lock must not be a symlink")
+    with lock.open("a+b") as handle:
+        if os.name == "nt":
+            import msvcrt
+            handle.seek(0)
+            handle.write(b"0")
+            handle.flush()
+            handle.seek(0)
+            msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            if os.name == "nt":
+                handle.seek(0)
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def write_transaction(skill_dir: Path, contents: dict[str, str]) -> None:
+    """Stage every artifact first; restore prior files if committing fails.
+
+    meta.json is the final commit record. Readers of mutable local artifacts must
+    take profile_lock; the server platform uses immutable versions instead.
+    """
+    paths = {}
+    for name in contents:
+        path = resolve_contained_child(skill_dir, name, "artifact filename")
+        if path.is_symlink():
+            raise ValueError("artifact must not be a symlink")
+        paths[name] = path
+    with tempfile.TemporaryDirectory(prefix=".transaction-", dir=skill_dir) as tmp:
+        staging = Path(tmp)
+        previous = {}
+        for name, text in contents.items():
+            previous[name] = paths[name].read_bytes() if paths[name].exists() else None
+            (staging / name).write_text(text, encoding="utf-8")
+        committed = []
+        try:
+            for name in contents:
+                os.replace(staging / name, paths[name])
+                committed.append(name)
+        except Exception:
+            for name in reversed(committed):
+                if previous[name] is None:
+                    paths[name].unlink(missing_ok=True)
+                else:
+                    paths[name].write_bytes(previous[name])
+            raise
+
+
+def snapshot(skill_dir: Path, destination: Path) -> None:
+    """Keep complete immutable snapshots; repeated identical backup is a no-op."""
+    contents = {}
+    for name in PRIMARY_ARTIFACTS:
+        path = resolve_contained_child(skill_dir, name, "artifact filename")
+        if path.is_symlink():
+            raise ValueError("artifact must not be a symlink")
+        if path.exists():
+            contents[name] = path.read_bytes()
+    if destination.exists():
+        actual = {p.name: p.read_bytes() for p in destination.iterdir() if p.is_file()}
+        if actual != contents:
+            raise FileExistsError(f"immutable snapshot already exists: {destination.name}")
+        return
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=".snapshot-", dir=destination.parent) as tmp:
+        staging = Path(tmp) / "snapshot"
+        staging.mkdir()
+        for name, data in contents.items():
+            (staging / name).write_bytes(data)
+        staging.rename(destination)
+
+
+def next_version(skill_dir: Path, meta: dict) -> str:
+    versions = [str(meta.get("version", "v1"))]
+    directory = resolve_contained_child(skill_dir, "versions", "versions directory")
+    if directory.exists():
+        versions.extend(p.name for p in directory.iterdir() if p.is_dir())
+    numbers = [int(m.group(1)) for v in versions if (m := re.match(r"^v(\d+)(?:_|$)", v))]
+    return f"v{max(numbers, default=0) + 1}"
