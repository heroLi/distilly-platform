+        run: node platform/tests/question_ui_test.cjs
+      - name: Test Worker gateway protocol
+        run: python3 -m unittest discover -s platform/worker -p 'test_*.py'
+      - name: Verify full workflow and restart persistence
+        run: python3 platform/tests/e2e.py
