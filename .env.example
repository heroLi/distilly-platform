# Copy to .env; never commit real credentials. Use independent random secrets.
PLATFORM_DB_PASSWORD=replace-with-random-database-password
PLATFORM_WORKER_TOKEN=replace-with-random-worker-token-at-least-32-characters
PLATFORM_USERS=[{"id":"alice","token":"replace-with-personal-random-token-at-least-32-characters"},{"id":"bob","token":"replace-with-another-independent-personal-token-at-least-32-characters"}]
MODEL_BASE_URL=https://api.deepseek.com/v1
# Set the actual model ID available to your DeepSeek account/internal gateway.
MODEL_NAME=deepseek-flash
MODEL_API_KEY=replace-with-gateway-key
MODEL_JSON_MODE=true

# Optional image generation gateway. Must support /images/generations + b64_json.
# Without these, use local avatar upload; image tasks report MEDIA_NOT_CONFIGURED.
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=

# Set false for gateways that reject stream=true; non-SSE responses are also supported.
MODEL_STREAMING=true

# Optional server-side speech gateway (independent of text model).
SPEECH_BASE_URL=
SPEECH_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
ASR_MODEL=

# Optional vision-capable Chat Completions gateway for image conversations.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Logical task admission only, not a monetary budget; 0 disables an individual limit.
PLATFORM_MAX_ACTIVE_TASKS_PER_USER=32
PLATFORM_TASK_SUBMISSIONS_PER_MINUTE=60
PLATFORM_TOTAL_TASK_SUBMISSIONS_PER_MINUTE=120

# Explicit Chat Completions output budgets (256..32768); not applied to image/audio APIs.
MODEL_OUTPUT_TOKEN_PARAMETER=max_tokens
MODEL_DEFAULT_OUTPUT_TOKENS=4096
MODEL_PERSONA_ANALYSIS_OUTPUT_TOKENS=4096
MODEL_PERSONA_BUILD_OUTPUT_TOKENS=8192
MODEL_DISTILL_OUTPUT_TOKENS=4096
MODEL_KNOWLEDGE_ANSWER_OUTPUT_TOKENS=2048
# Use max_completion_tokens where the gateway requires it; omit removes temperature entirely.
MODEL_TEMPERATURE=0
# Optional independent vision policy; when absent it inherits text policy values.
# VISION_OUTPUT_TOKEN_PARAMETER=max_tokens
# VISION_DEFAULT_OUTPUT_TOKENS=4096
# VISION_TEMPERATURE=0
# VISION_JSON_MODE=false
# VISION_STREAMING=true
