{
  "dataset_id": "RECORD_RETRIEVAL_INDEPENDENT_HOLDOUT_V1",
  "split": "holdout",
  "historical_corpus_restored": false,
  "description": "独立创建的冻结合成保留集，仅评当前人格选中、同空间、当前已审核工作资料的记录卡检索；不是缺失历史语料、私人记忆或真实模型质量复验。",
  "frozen_before_algorithm_evaluation": true,
  "expectation_protocol": {
    "expected_keys": "所有相关且可访问的原文记录；多余返回为误召回，遗漏为漏召回；拒绝访问用 expect_access=denied。",
    "negation": "相关否定和冲突原文可返回，须原样保留；检索命中不等于肯定事实或自动消解冲突。",
    "unmatched": "expected_keys为空且允许访问时，应返回空记录卡和固定资料不足提示，不生成事实答案。",
    "scope": "同空间共享的已选已审核资料对有权VIEWER可读；非成员、foreign、unselected和unpublished不得被扩大读取。",
    "failure_policy": "按类别保留所有失败，不能依据保留题面添加查询-答案或翻译映射；曝光后不得继续作为未见保留集。"
  },
